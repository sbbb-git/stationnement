# --- PayByPhone (fournisseur par défaut, celui qu'utilise AlloValet) ---
# Identifiant = le numéro de téléphone (format +33...) ou l'email du compte.
PBP_USERNAME=+33600000000
PBP_PASSWORD=ton_mot_de_passe

# --- EasyPark (uniquement si `provider: easypark` dans config.yml) ---
# Obtenus une fois avec : python -m allovalet easypark-login
# EP_ID_TOKEN=
# EP_PARKING_USER_ID=

# --- Notifications (facultatif mais recommandé) ---
# Installe l'app ntfy, abonne-toi à un sujet secret, mets-le ici.
# NTFY_TOPIC=stationnement-xxxxxxxx
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
